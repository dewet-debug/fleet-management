# Example environment configuration for the fleet-management server.
# Copy to `.env` and fill in real values. `.env` is gitignored; this file is safe to commit.

# Core
DATABASE_URL="file:./dev.db"
PORT=3001
JWT_SECRET=change-me
JWT_REFRESH_SECRET=change-me
UPLOAD_DIR=./uploads

# Cartrack Fleet API (telematics)
CARTRACK_API_BASE_URL=https://fleetapi-za.cartrack.com/rest/
CARTRACK_API_USERNAME=
CARTRACK_API_PASSWORD=
CARTRACK_ENCRYPTION_KEY=change-me-in-prod

# Bolt Fleet Integration (commercial/trip data) - OAuth2 client_credentials
# Generate via Bolt Fleet Portal (fleets.bolt.eu) -> Settings -> API -> Generate credentials.
BOLT_CLIENT_ID=
BOLT_CLIENT_SECRET=
BOLT_OIDC_TOKEN_URL=https://oidc.bolt.eu/token
BOLT_OAUTH_SCOPE=fleet-integration:api
