# Example environment configuration for the fleet-management server.
# Copy to `.env` and fill in real values. `.env` is gitignored; this file is safe to commit.

# Core
# Postgres. On Railway, add the PostgreSQL plugin and it injects these automatically.
#   DATABASE_URL = pooled connection (used by the app at runtime)
#   DIRECT_URL   = direct connection (used by prisma migrate)
# For local dev against SQLite history, see docs/cloud-migration-plan.md (Phase 2).
DATABASE_URL="postgresql://user:password@host:5432/fleet?schema=public"
DIRECT_URL="postgresql://user:password@host:5432/fleet?schema=public"
PORT=3001
JWT_SECRET=change-me
JWT_REFRESH_SECRET=change-me
# On Railway, mount a Volume and point this at it (e.g. /data/uploads) so uploads persist.
UPLOAD_DIR=./uploads

# Set to "production" on Railway. Enables secure + SameSite=None auth cookies for the
# cross-origin (Vercel front-end -> Railway API) deploy.
NODE_ENV=development
# Comma-separated allow-list of browser origins for CORS = the Vercel URL(s).
# Leave empty for local dev (the server then reflects the request origin).
CLIENT_ORIGIN=

# Cartrack Fleet API (telematics)
CARTRACK_API_BASE_URL=https://fleetapi-za.cartrack.com/rest/
CARTRACK_API_USERNAME=
CARTRACK_API_PASSWORD=
CARTRACK_ENCRYPTION_KEY=change-me-in-prod

# Bolt Fleet Integration (commercial/trip data) - OAuth2 client_credentials
# Generate via Bolt Fleet Portal (fleets.bolt.eu) -> Settings -> API -> Generate credentials.
BOLT_CLIENT_ID=
BOLT_CLIENT_SECRET=
BOLT_OIDC_TOKEN_URL=https://oidc.bolt.eu/token
BOLT_OAUTH_SCOPE=fleet-integration:api
