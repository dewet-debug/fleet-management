  "paths": {
    "/fleetIntegration/v1/test": {
      "post": {
        "operationId": "fleetIntegrationV1Test",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/FleetIntegration.GetMockDataRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "code": {
                      "type": "number"
                    },
                    "message": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "code",
                    "message"
                  ]
                }
              }
            }
          }
        },
        "description": "Endpoint just for testing purposes.\nIf the request is made correctly it should respond with an OK response.\n<br>\n<br>\nExpects a request body containing:\n<br>\n`start_ts` - unix timestamp to find orders which created time is after this timestamp.\n<br>\n`end_ts` - unix timestamp to find orders which created time is before this timestamp.\n<br>\n`company_ids` - company ID-s for which you want to find orders for.\n<br>",
        "tags": [
          "public-api-doc"
        ]
      }
    },
    "/fleetIntegration/v1/getFleetOrders": {
      "post": {
        "operationId": "fleetIntegrationV1GetFleetOrders",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/FleetIntegration.GetFleetOrdersRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "code": {
                      "type": "number"
                    },
                    "message": {
                      "type": "string"
                    },
                    "data": {
                      "$ref": "#/components/schemas/FleetIntegration.GetFleetOrdersResponse"
                    }
                  },
                  "required": [
                    "code",
                    "message",
                    "data"
                  ]
                }
              }
            }
          }
        },
        "description": "Endpoint to request orders data of a company filtered by time range. By default the response is sorted by order creation time.\nIf the request is made correctly it responds with a list of orders.\n<br>\n<br>\nExpects a request body containing:\n<br>\n`company_id` - company ID for which you want to find orders for.\n<br>\n`company_ids` - company ID-s for which you want to find orders for. First one will be used in case company_id is not provided.\n<br>\n`limit` - the amount of records received per request. For pagination. Must be a number between 1 and 1000.\n<br>\n`offset` - the number of records to skip before returning records. For pagination.\n<br>\n`start_ts` - unix timestamp to find orders which time_range_filter_type time is after this timestamp.\n<br>\n`end_ts` - unix timestamp to find orders which time_range_filter_type time is before this timestamp.\n<br>\n`time_range_filter_type` - optional. By default, rides are filtered by creation date. To filter by the date and time when fares were finalized, set this parameter to PRICE_REVIEW.\n<br>\nThrows:\n<br>\n**498805 - INVALID_START_DATE** The start date is before allowed date.\n\n**498806 - INVALID_DATE_RANGE** Date range is too long.\n\n**498809 - COMPANY_NOT_ACTIVE** Company is not active anymore.\n\n**498810 - COMPANY_NOT_ALLOWED** Cannot retrieve details from company.",
        "tags": [
          "public-api-doc"
        ]
      }
    },
    "/fleetIntegration/v1/getFleetStateLogs": {
      "post": {
        "operationId": "fleetIntegrationV1GetFleetStateLogs",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/FleetIntegration.GetCompanyPageWithTimerangeRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "code": {
                      "type": "number"
                    },
                    "message": {
                      "type": "string"
                    },
                    "data": {
                      "$ref": "#/components/schemas/FleetIntegration.GetFleetStateLogsResponse"
                    }
                  },
                  "required": [
                    "code",
                    "message",
                    "data"
                  ]
                }
              }
            }
          }
        },
        "description": "Endpoint to request fleet drivers state logs filtered by time range, by default the response is ordered by state created time.\nIf the request is made correctly it responds with a list of fleet driver state logs.\n<br>\n<br>\nExpects a request body containing:\n<br>\n`limit` - the amount of state logs received per request. For pagination. Must be a number between 1 and 1000.\n<br>\n`offset` - the number of records to skip before returning records. For pagination.\n<br>\n`start_ts` - unix timestamp to find state logs which created time is after this timestamp.\n<br>\n`end_ts` - unix timestamp to find state logs which created time is before this timestamp.\n<br>\n`company_id` - company ID for which you want to find driver state logs for.\n<br>\nThrows:\n<br>\n**498805 - INVALID_START_DATE** The start date is before allowed date.\n\n**498806 - INVALID_DATE_RANGE** Date range is too long.\n\n**498807 - COMPANY_NOT_FOUND** The company in the request doesn't exist.\n\n**498810 - COMPANY_NOT_ALLOWED** User does not have access to the company in the request.",
        "tags": [
          "public-api-doc"
        ]
      }
    },
    "/fleetIntegration/v1/getDrivers": {
      "post": {
        "operationId": "fleetIntegrationV1GetDrivers",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/FleetIntegration.GetFleetDriversRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "code": {
                      "type": "number"
                    },
                    "message": {
                      "type": "string"
                    },
                    "data": {
                      "$ref": "#/components/schemas/FleetIntegration.GetFleetDriversResponse"
                    }
                  },
                  "required": [
                    "code",
                    "message",
                    "data"
                  ]
                }
              }
            }
          }
        },
        "description": "Endpoint to request fleet drivers filtered by time range, portal status and/or search keyword. By default the response is ordered by state created time.\nIf the request is made correctly it responds with a list of fleet drivers.\n<br>\n<br>\nExpects a request body containing:\n<br>\n`company_id` - company ID for which you want to find drivers for.\n<br>\n`limit` - the amount of drivers received per request. For pagination. Must be a number between 1 and 1000.\n<br>\n`offset` - the number of records to skip before returning records. For pagination.\n<br>\n`start_ts` - unix timestamp to find drivers which created time is after this timestamp.\n<br>\n`end_ts` - unix timestamp to find drivers which created time is before this timestamp.\n<br>\n`portal_status` - Status filter for driver. Optional.\n<br>\n`search` - Keyword filter for driver names. Optional.\n<br>\nThrows:\n<br>\n**498805 - INVALID_START_DATE** The start date is before allowed date.\n\n**498806 - INVALID_DATE_RANGE** Date range is too long.\n\n**498807 - COMPANY_NOT_FOUND** The company in the request doesn't exist.\n\n**498809 - COMPANIES_NOT_ACTIVE** The company is not active anymore.",
        "tags": [
          "public-api-doc"
        ]
      }
    },
    "/fleetIntegration/v1/getCompanies": {
      "get": {
        "operationId": "fleetIntegrationV1GetCompanies",
