                    "data"
                  ]
                }
              }
            }
          }
        },
        "description": "Endpoint that returns a list of company ID-s that the authenticated user has access to.\n<br>\n<br>\nDoesn't expect a request body.",
        "tags": [
          "public-api-doc"
        ]
      }
    },
    "/fleetIntegration/v1/getVehicles": {
      "post": {
        "operationId": "fleetIntegrationV1GetVehicles",
