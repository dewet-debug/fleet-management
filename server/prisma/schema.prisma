generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// Note: SQLite doesn't support enums. We use String fields with validation at the app layer.
// UserRole: ADMIN, FLEET_MANAGER, SERVICE_COMPANY
// VehicleStatus: ACTIVE, IN_SERVICE, OUT_OF_SERVICE, RETIRED
// DriverStatus: ACTIVE, INACTIVE, SUSPENDED
// AssignmentStatus: ACTIVE, ENDED
// ServiceStatus: DRAFT, SCHEDULED, AUTHORIZED, IN_PROGRESS, COMPLETED, APPROVED, RETURNED
// ConditionRating: EXCELLENT, GOOD, FAIR, POOR, CRITICAL
// PhotoType: BEFORE_SERVICE, DURING_SERVICE, AFTER_SERVICE, DAMAGE, GENERAL

model User {
  id           String    @id @default(uuid())
  email        String    @unique
  passwordHash String
  firstName    String
  lastName     String
  role         String    @default("FLEET_MANAGER")
  isActive     Boolean   @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  assignmentsCreated         Assignment[]           @relation("AssignmentCreatedBy")
  serviceRecordsAuthorized   ServiceRecord[]        @relation("ServiceAuthorizedBy")
  serviceRecordsApproved     ServiceRecord[]        @relation("ServiceApprovedBy")
  serviceRecordsCreated      ServiceRecord[]        @relation("ServiceCreatedBy")
  serviceStatusHistories     ServiceStatusHistory[]
  photosUploaded             Photo[]
  auditLogs                  AuditLog[]
}

model Vehicle {
  id             String   @id @default(uuid())
  vin            String   @unique
  licensePlate   String   @unique
  make           String
  model          String
  year           Int
  color          String
  status         String   @default("ACTIVE")
  currentKilometers Int      @default(0)
  fuelType          String
  purchaseDate       DateTime?
  purchasePrice      Float?
  currency           String    @default("ZAR")
  fleetNumber        String?
  leaseCompany       String?
  leaseAgreementNo   String?
  leaseStartDate     DateTime?
  leaseEndDate       DateTime?
  monthlyLeaseCost   Float?
  currentBookValue   Float?
  insuranceProvider  String?
  insurancePolicyNo  String?
  coverageType       String?
  policyStartDate    DateTime?
  policyExpiryDate   DateTime?
  premiumAmount      Float?
  registrationExpiry DateTime?
  warrantyExpiry     DateTime?
  notes              String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  assignments             Assignment[]
  serviceRecords          ServiceRecord[]
  vehicleServiceIntervals VehicleServiceInterval[]
  cartrackFleetVehicle    CartrackFleetVehicle?
  boltTrips               BoltTrip[]
}

model Driver {
  id            String   @id @default(uuid())
  employeeId    String   @unique
  firstName     String
  lastName      String
  email         String   @unique
  phone         String?
  licenseNumber String
  licenseExpiry DateTime
  status        String   @default("ACTIVE")
  notes         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  assignments    Assignment[]
  serviceRecords ServiceRecord[] @relation("ServiceDriver")
}

model Assignment {
  id        String    @id @default(uuid())
  vehicleId String
  driverId  String
  status    String    @default("ACTIVE")
  startDate DateTime
  endDate   DateTime?
  notes     String?
  createdBy String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  vehicle       Vehicle @relation(fields: [vehicleId], references: [id])
  driver        Driver  @relation(fields: [driverId], references: [id])
  createdByUser User    @relation("AssignmentCreatedBy", fields: [createdBy], references: [id])

  @@index([vehicleId])
  @@index([driverId])
  @@index([createdBy])
}

model ServiceProvider {
  id          String   @id @default(uuid())
  name        String
  contactName String
  email       String
  phone       String
  address     String
  specialties String   @default("[]")
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  serviceRecords ServiceRecord[]
}

model ServiceTypeConfig {
  id                String   @id @default(uuid())
  name              String
  description       String?
  category          String?
  estimatedDuration String?
  isActive          Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  serviceIntervalConfigs ServiceIntervalConfig[]
  serviceRecords         ServiceRecord[]
}

model ServiceIntervalConfig {
  id               String   @id @default(uuid())
  serviceTypeId    String
  vehicleMake      String?
  vehicleModel     String?
  kilometerInterval Int?
  timeIntervalDays Int?
  isActive         Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  serviceType             ServiceTypeConfig        @relation(fields: [serviceTypeId], references: [id])
  vehicleServiceIntervals VehicleServiceInterval[]

  @@index([serviceTypeId])
}

model VehicleServiceInterval {
  id                      String    @id @default(uuid())
  vehicleId               String
  serviceIntervalConfigId String
  lastServiceDate         DateTime?
  lastServiceKilometers   Int?
  nextServiceDate         DateTime?
  nextServiceKilometers   Int?
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt

  vehicle               Vehicle               @relation(fields: [vehicleId], references: [id])
  serviceIntervalConfig ServiceIntervalConfig @relation(fields: [serviceIntervalConfigId], references: [id])

  @@index([vehicleId])
  @@index([serviceIntervalConfigId])
}

model ServiceRecord {
  id                  String    @id @default(uuid())
  vehicleId           String
  serviceProviderId   String?
  serviceTypeConfigId String
  status              String    @default("DRAFT")
  description         String
  scheduledDate       DateTime?
  authorizedBy        String?
  authorizedAt        DateTime?
  startedAt           DateTime?
  completedAt         DateTime?
  approvedBy          String?
  approvedAt          DateTime?
  returnedAt          DateTime?
  driverId            String?
  laborCost           Float?
  partsCost           Float?
  additionalCharges   Float?
  vatAmount           Float?
  totalCostExclVat    Float?
  totalCostInclVat    Float?
  currency            String   @default("ZAR")
  invoiceNumber       String?
  invoiceDate         DateTime?
  paymentMethod       String?
  isWarrantyClaim     Boolean  @default(false)
  kilometersAtService Int?
  conditionBefore     String?
  conditionAfter      String?
  technicianNotes     String?
  internalNotes       String?
  createdBy           String
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  vehicle           Vehicle          @relation(fields: [vehicleId], references: [id])
  serviceProvider   ServiceProvider? @relation(fields: [serviceProviderId], references: [id])
  serviceType       ServiceTypeConfig @relation(fields: [serviceTypeConfigId], references: [id])
  driver            Driver?          @relation("ServiceDriver", fields: [driverId], references: [id])
  authorizedByUser  User?            @relation("ServiceAuthorizedBy", fields: [authorizedBy], references: [id])
  approvedByUser    User?            @relation("ServiceApprovedBy", fields: [approvedBy], references: [id])
  createdByUser     User             @relation("ServiceCreatedBy", fields: [createdBy], references: [id])

  statusHistory ServiceStatusHistory[]
  photos        Photo[]

  @@index([vehicleId])
  @@index([serviceProviderId])
  @@index([driverId])
  @@index([serviceTypeConfigId])
  @@index([authorizedBy])
  @@index([approvedBy])
  @@index([createdBy])
}

model ServiceStatusHistory {
  id              String   @id @default(uuid())
  serviceRecordId String
  fromStatus      String?
  toStatus        String
  changedBy       String
  notes           String?
  createdAt       DateTime @default(now())

  serviceRecord ServiceRecord @relation(fields: [serviceRecordId], references: [id])
  changedByUser User          @relation(fields: [changedBy], references: [id])

  @@index([serviceRecordId])
  @@index([changedBy])
}

model Photo {
  id              String   @id @default(uuid())
  serviceRecordId String
  url             String
  filename        String
  mimeType        String
  size            Int
  type            String
  caption         String?
  uploadedBy      String
  createdAt       DateTime @default(now())

  serviceRecord  ServiceRecord @relation(fields: [serviceRecordId], references: [id])
  uploadedByUser User          @relation(fields: [uploadedBy], references: [id])

  @@index([serviceRecordId])
  @@index([uploadedBy])
}

model AuditLog {
  id         String   @id @default(uuid())
  userId     String?
  action     String
  entityType String
  entityId   String
  details    String?
  ipAddress  String?
  createdAt  DateTime @default(now())

  user User? @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([entityType, entityId])
}

// ============================================================
// CARTRACK INTEGRATION MODELS
// ============================================================

model CartrackConfig {
  id                    String   @id @default(uuid())
  apiBaseUrl            String   @default("https://fleetapi-za.cartrack.com/rest/")
  apiUsername            String   @default("")
  apiPasswordEncrypted  String   @default("")
  isEnabled             Boolean  @default(false)
  syncIntervalMinutes   Int      @default(15)
  vehicleSyncEnabled    Boolean  @default(true)
  tripSyncEnabled       Boolean  @default(true)
  driverSyncEnabled     Boolean  @default(true)
  alertSyncEnabled      Boolean  @default(true)
  fuelSyncEnabled       Boolean  @default(true)
  coachingSyncEnabled     Boolean @default(true)
  geofenceSyncEnabled     Boolean @default(true)
  vehicleEventSyncEnabled Boolean @default(true)
  reminderSyncEnabled     Boolean @default(true)
  poiSyncEnabled          Boolean @default(true)
  lastHealthCheck       DateTime?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
}

model CartrackFleetVehicle {
  id                String    @id @default(uuid())
  vehicleId         String    @unique
  licensePlate      String    @unique
  cartrackVehicleId String?   @unique
  isActive          Boolean   @default(true)
  lastSyncedAt      DateTime?
  syncStatus        String    @default("PENDING")
  syncErrorMessage  String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  vehicle             Vehicle               @relation(fields: [vehicleId], references: [id])
  cartrackVehicleData CartrackVehicleData?
  cartrackTrips       CartrackTrip[]
  cartrackAlerts      CartrackAlert[]
  cartrackFuelRecords CartrackFuelRecord[]
  cartrackCoachingEvents CartrackCoachingEvent[]
  cartrackVehicleEvents  CartrackVehicleEvent[]

  @@index([vehicleId])
  @@index([licensePlate])
  @@index([cartrackVehicleId])
}

model CartrackVehicleData {
  id                      String    @id @default(uuid())
  cartrackFleetVehicleId  String    @unique
  cartrackVehicleId       String
  registrationNumber      String?
  make                    String?
  model                   String?
  year                    String?
  odometer                Float?
  lastLatitude            Float?
  lastLongitude           Float?
  lastSpeed               Float?
  lastIgnitionStatus      String?
  lastEventTime           DateTime?
  fuelLevel               Float?
  rawVehicleJson          String
  rawStatusJson           String?
  fetchedAt               DateTime  @default(now())
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt

  cartrackFleetVehicle CartrackFleetVehicle @relation(fields: [cartrackFleetVehicleId], references: [id])

  @@index([cartrackFleetVehicleId])
  @@index([cartrackVehicleId])
}

model CartrackTrip {
  id                      String    @id @default(uuid())
  cartrackFleetVehicleId  String
  cartrackTripId          String    @unique
  startTime               DateTime?
  endTime                 DateTime?
  startLatitude           Float?
  startLongitude          Float?
  endLatitude             Float?
  endLongitude            Float?
  startAddress            String?
  endAddress              String?
  distanceKm              Float?
  durationMinutes         Float?
  maxSpeed                Float?
  averageSpeed            Float?
  idlingDurationMinutes   Float?
  fuelUsedLitres          Float?
  driverName              String?
  rawJson                 String
  fetchedAt               DateTime  @default(now())
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt

  cartrackFleetVehicle CartrackFleetVehicle @relation(fields: [cartrackFleetVehicleId], references: [id])

  @@index([cartrackFleetVehicleId])
  @@index([startTime])
  @@index([endTime])
}

model CartrackDriver {
  id                String    @id @default(uuid())
  cartrackDriverId  String    @unique
  firstName         String?
  lastName          String?
  employeeNumber    String?
  licenseNumber     String?
  phone             String?
  email             String?
  status            String?
  rawJson           String
  fetchedAt         DateTime  @default(now())
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  driverLinkages CartrackDriverLinkage[]

  @@index([cartrackDriverId])
  @@index([employeeNumber])
}

model CartrackDriverLinkage {
  id                String    @id @default(uuid())
  cartrackVehicleId String
  cartrackDriverId  String
  startDate         DateTime?
  endDate           DateTime?
  rawJson           String
  fetchedAt         DateTime  @default(now())
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  cartrackDriver CartrackDriver @relation(fields: [cartrackDriverId], references: [cartrackDriverId])

  @@unique([cartrackVehicleId, cartrackDriverId])
  @@index([cartrackVehicleId])
  @@index([cartrackDriverId])
}

model CartrackAlert {
  id                      String    @id @default(uuid())
  cartrackFleetVehicleId  String
  cartrackAlertId         String    @unique
  alertType               String?
  severity                String?
  message                 String?
  latitude                Float?
  longitude               Float?
  eventTime               DateTime?
  isAcknowledged          Boolean   @default(false)
  acknowledgedBy          String?
  acknowledgedAt          DateTime?
  rawJson                 String
  fetchedAt               DateTime  @default(now())
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt

  cartrackFleetVehicle CartrackFleetVehicle @relation(fields: [cartrackFleetVehicleId], references: [id])

  @@index([cartrackFleetVehicleId])
  @@index([alertType])
  @@index([eventTime])
}

model CartrackFuelRecord {
  id                      String    @id @default(uuid())
  cartrackFleetVehicleId  String
  cartrackFuelId          String    @unique
  eventTime               DateTime?
  litres                  Float?
  costPerLitre            Float?
  totalCost               Float?
  odometer                Float?
  location                String?
  fuelType                String?
  rawJson                 String
  fetchedAt               DateTime  @default(now())
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt

  cartrackFleetVehicle CartrackFleetVehicle @relation(fields: [cartrackFleetVehicleId], references: [id])

  @@index([cartrackFleetVehicleId])
  @@index([eventTime])
}

model CartrackVehicleGroup {
  id              String    @id @default(uuid())
  cartrackGroupId String    @unique
  name            String
  description     String?
  vehicleCount    Int       @default(0)
  rawJson         String
  fetchedAt       DateTime  @default(now())
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([cartrackGroupId])
}

model CartrackSyncLog {
  id                String    @id @default(uuid())
  syncType          String
  status            String
  triggeredBy       String
  triggeredByUserId String?
  startedAt         DateTime  @default(now())
  completedAt       DateTime?
  recordsFetched    Int       @default(0)
  recordsCreated    Int       @default(0)
  recordsUpdated    Int       @default(0)
  recordsErrored    Int       @default(0)
  errorMessage      String?
  errorDetails      String?
  durationMs        Int?
  createdAt         DateTime  @default(now())

  @@index([syncType])
  @@index([status])
  @@index([startedAt])
}

// ---- Extended Cartrack resources (coaching, geofences, events, reminders, POIs) ----

model CartrackCoachingEvent {
  id                     String    @id @default(uuid())
  cartrackEventId        String    @unique
  cartrackFleetVehicleId String?
  driverName             String?
  eventType              String?
  score                  Float?
  latitude               Float?
  longitude              Float?
  eventTime              DateTime?
  rawJson                String
  fetchedAt              DateTime  @default(now())
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  cartrackFleetVehicle CartrackFleetVehicle? @relation(fields: [cartrackFleetVehicleId], references: [id])

  @@index([cartrackFleetVehicleId])
  @@index([eventType])
  @@index([eventTime])
}

model CartrackGeofence {
  id                String    @id @default(uuid())
  cartrackGeofenceId String   @unique
  name              String?
  type              String?
  latitude          Float?
  longitude         Float?
  radius            Float?
  rawJson           String
  fetchedAt         DateTime  @default(now())
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([cartrackGeofenceId])
}

model CartrackGeofenceVisit {
  id                 String    @id @default(uuid())
  cartrackVisitId    String    @unique
  cartrackGeofenceId String?
  cartrackVehicleId  String?
  geofenceName       String?
  entryTime          DateTime?
  exitTime           DateTime?
  durationMinutes    Float?
  rawJson            String
  fetchedAt          DateTime  @default(now())
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@index([cartrackGeofenceId])
  @@index([cartrackVehicleId])
  @@index([entryTime])
}

model CartrackVehicleEvent {
  id                     String    @id @default(uuid())
  cartrackEventId        String    @unique
  cartrackFleetVehicleId String?
  eventType              String?
  latitude               Float?
  longitude              Float?
  speed                  Float?
  eventTime              DateTime?
  rawJson                String
  fetchedAt              DateTime  @default(now())
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  cartrackFleetVehicle CartrackFleetVehicle? @relation(fields: [cartrackFleetVehicleId], references: [id])

  @@index([cartrackFleetVehicleId])
  @@index([eventType])
  @@index([eventTime])
}

model CartrackReminder {
  id                 String    @id @default(uuid())
  cartrackReminderId String    @unique
  registrationNumber String?
  reminderType       String?
  title              String?
  dueDate            DateTime?
  status             String?
  rawJson            String
  fetchedAt          DateTime  @default(now())
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@index([registrationNumber])
  @@index([dueDate])
}

model CartrackPoi {
  id           String    @id @default(uuid())
  cartrackPoiId String   @unique
  name         String?
  category     String?
  latitude     Float?
  longitude    Float?
  address      String?
  rawJson      String
  fetchedAt    DateTime  @default(now())
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([cartrackPoiId])
}

// ============================================================
// A49 INTEGRATION MODELS
// ============================================================

model A49Driver {
  id                    String    @id @default(uuid())
  externalId            String    @unique
  company               String?
  licensePlate          String?
  vehicleType           String?
  vehicleStatus         String?
  driverFullName        String
  driverPersonalCode    String?
  dateDriverAssigned    DateTime?
  driverContactNumber   String?
  driverEmail           String?
  driverAddress         String?
  currentOdo            Float?
  kmYesterday           Float?
  kmMonthToDate         Float?
  rawJson               String
  fetchedAt             DateTime  @default(now())
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([licensePlate])
  @@index([driverFullName])
}

model A49JobCard {
  id                          String    @id @default(uuid())
  jobCardNumber               String    @unique
  jobCardType                 String?
  jobCardStatus               String?
  poEmailSent                 DateTime?
  quotedTotalsExclVat         Float?
  poTotalExclVat              Float?
  poNumber                    String?
  registrationNumber          String?
  associatedMake              String?
  associatedModel             String?
  lastRecordedOdo             Float?
  currentOdo                  Float?
  insuranceRelated            Boolean   @default(false)
  associatedMerchant          String?
  jobCardOpenedDate           DateTime?
  bookedInDate                DateTime?
  dateQuoteSubmitted          DateTime?
  poApprovedDate              DateTime?
  dateRepairStarted           DateTime?
  dateRepairCompleted         DateTime?
  jobCardClosedDate           DateTime?
  repairEtaDate               DateTime?
  finalInspectionDate         DateTime?
  daysJobCardBookedIn         Int?
  daysQuoteSubmitted          Int?
  daysPoApproved              Int?
  daysPoSent                  Int?
  daysInRepair                Int?
  daysSinceOpenedToClose      Int?
  totalOemPartPriceExclVat    Float?
  totalLabourHoursExclVat     Float?
  totalLabourCostPerHourExclVat Float?
  totalStripAssembleHoursExclVat Float?
  totalApprovedOemPartPriceExclVat Float?
  totalApprovedLabourHoursExclVat Float?
  totalApprovedLabourCostPerHourExclVat Float?
  totalApprovedStripAssembleHoursExclVat Float?
  rawJson                     String
  fetchedAt                   DateTime  @default(now())
  createdAt                   DateTime  @default(now())
  updatedAt                   DateTime  @updatedAt

  @@index([registrationNumber])
  @@index([jobCardStatus])
}

model A49SyncLog {
  id              String    @id @default(uuid())
  syncType        String
  status          String
  triggeredBy     String
  startedAt       DateTime  @default(now())
  completedAt     DateTime?
  recordsFetched  Int       @default(0)
  recordsCreated  Int       @default(0)
  recordsUpdated  Int       @default(0)
  recordsErrored  Int       @default(0)
  errorMessage    String?
  durationMs      Int?
  createdAt       DateTime  @default(now())

  @@index([syncType])
  @@index([status])
  @@index([startedAt])
}

// ============================================================
// BOLT FLEET INTEGRATION MODELS
// Commercial/trip data from the Bolt Fleet Integration API
// (getFleetOrders). Field names/types mirror the live API payload
// (see server/src/lib/bolt/fleet-integration-openapi.json), adapted to
// SQLite: rawJson String (not JSONB), Float (not DECIMAL), DateTime for
// unix-second timestamps. Joins to the vehicle registry by license plate.
// ============================================================

model BoltTrip {
  id                     String    @id @default(uuid())
  orderReference         String    @unique
  companyId              Int?

  // Vehicle registry match (by plate, same approach as Cartrack)
  vehicleLicensePlate    String?
  vehicleId              String?
  vehicleModel           String?

  // Driver
  driverName             String?
  driverUuid             String?
  partnerUuid            String?
  driverPhone            String?

  // Trip
  orderStatus            String
  paymentMethod          String?
  isScheduled            Boolean   @default(false)
  categoryName           String?
  categorySeats          Int?
  categoryVehicleType    String?
  pickupAddress          String?
  destinationAddress     String?
  pickupLat              Float?
  pickupLng              Float?
  dropoffLat             Float?
  dropoffLng             Float?
  rideDistanceMeters     Float?
  roadDistanceAtMatching Float?

  // Lifecycle timestamps (unix seconds in the API -> DateTime here)
  orderCreatedAt         DateTime
  orderAcceptedAt        DateTime?
  orderPickupAt          DateTime?
  orderDropOffAt         DateTime?
  orderFinishedAt        DateTime?
  orderCancelledAt       DateTime?
  orderNoShowAt          DateTime?
  paymentConfirmedAt     DateTime?

  // Price components (ZAR)
  ridePrice              Float?
  bookingFee             Float?
  tollFee                Float?
  cancellationFee        Float?
  tip                    Float?
  netEarnings            Float?
  cashDiscount           Float?
  inAppDiscount          Float?
  commission             Float?
  currency               String    @default("ZAR")

  priceReviewReason      String?
  driverCancelledReason  String?

  rawJson                String
  syncedAt               DateTime  @default(now())
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  vehicle Vehicle? @relation(fields: [vehicleId], references: [id])

  @@index([vehicleLicensePlate])
  @@index([vehicleId])
  @@index([orderStatus])
  @@index([orderCreatedAt])
  @@index([orderFinishedAt])
}

model BoltSyncLog {
  id              String    @id @default(uuid())
  syncType        String
  status          String
  triggeredBy     String
  windowStart     DateTime?
  windowEnd       DateTime?
  startedAt       DateTime  @default(now())
  completedAt     DateTime?
  recordsFetched  Int       @default(0)
  recordsCreated  Int       @default(0)
  recordsUpdated  Int       @default(0)
  recordsMatched  Int       @default(0)
  recordsErrored  Int       @default(0)
  errorMessage    String?
  durationMs      Int?
  createdAt       DateTime  @default(now())

  @@index([syncType])
  @@index([status])
  @@index([startedAt])
}
