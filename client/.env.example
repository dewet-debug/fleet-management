# Client build-time config (Vite). Copy to `.env` for local overrides; `.env` is gitignored.
#
# Local dev leaves this UNSET: the client calls the relative /api/v1 and Vite's dev
# proxy (see vite.config.ts) forwards to http://localhost:3001.
#
# On Vercel, set VITE_API_URL to the deployed Railway API base (including /api/v1):
#   VITE_API_URL=https://<your-railway-backend>.up.railway.app/api/v1
VITE_API_URL=
